  "calculations": [
    {
      "id": "strengthModifier",
      "targetField": "attributes.strengthModifier",
      "triggers": ["strength"],
      "formula": "floor((strength - 10) / 2)",
      "description": "力量调整值计算"
    },
    {
      "id": "dexterityModifier",
      "targetField": "attributes.dexterityModifier",
      "triggers": ["dexterity"],
      "formula": "floor((dexterity - 10) / 2)",
      "description": "敏捷调整值计算"
    },
    {
      "id": "constitutionModifier",
      "targetField": "attributes.constitutionModifier",
      "triggers": ["constitution"],
      "formula": "floor((constitution - 10) / 2)",
      "description": "体质调整值计算"
    },
    {
      "id": "intelligenceModifier",
      "targetField": "attributes.intelligenceModifier",
      "triggers": ["intelligence"],
      "formula": "floor((intelligence - 10) / 2)",
      "description": "智力调整值计算"
    },
    {
      "id": "wisdomModifier",
      "targetField": "attributes.wisdomModifier",
      "triggers": ["wisdom"],
      "formula": "floor((wisdom - 10) / 2)",
      "description": "感知调整值计算"
    },
    {
      "id": "charismaModifier",
      "targetField": "attributes.charismaModifier",
      "triggers": ["charisma"],
      "formula": "floor((charisma - 10) / 2)",
      "description": "魅力调整值计算"
    },
    {
      "id": "baseArmorClass",
      "targetField": "attributes.armorClass",
      "triggers": ["dexterityModifier"],
      "formula": "10 + dexterityModifier",
      "description": "基础护甲等级"
    },
    {
      "id": "maxHitPoints",
      "targetField": "attributes.maxHitPoints",
      "triggers": ["constitutionModifier", "level"],
      "formula": "8 + constitutionModifier + (level - 1) * (6 + constitutionModifier)",
      "description": "最大生命值计算"
    }
  ],
  
  "dependencies": [],
  
  "validations": [],
  
