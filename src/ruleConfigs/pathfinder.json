  "calculations": [
    {
      "id": "abilityModifier_strength",
      "name": "力量调整值计算",
      "targetField": "attributes.strengthModifier",
      "formula": "Math.floor((strength - 10) / 2)",
      "triggers": ["strength"],
      "description": "计算力量调整值"
    },
    {
      "id": "abilityModifier_dexterity",
      "name": "敏捷调整值计算",
      "targetField": "attributes.dexterityModifier",
      "formula": "Math.floor((dexterity - 10) / 2)",
      "triggers": ["dexterity"],
      "description": "计算敏捷调整值"
    },
    {
      "id": "abilityModifier_constitution",
      "name": "体质调整值计算",
      "targetField": "attributes.constitutionModifier",
      "formula": "Math.floor((constitution - 10) / 2)",
      "triggers": ["constitution"],
      "description": "计算体质调整值"
    },
    {
      "id": "abilityModifier_intelligence",
      "name": "智力调整值计算",
      "targetField": "attributes.intelligenceModifier",
      "formula": "Math.floor((intelligence - 10) / 2)",
      "triggers": ["intelligence"],
      "description": "计算智力调整值"
    },
    {
      "id": "abilityModifier_wisdom",
      "name": "感知调整值计算",
      "targetField": "attributes.wisdomModifier",
      "formula": "Math.floor((wisdom - 10) / 2)",
      "triggers": ["wisdom"],
      "description": "计算感知调整值"
    },
    {
      "id": "abilityModifier_charisma",
      "name": "魅力调整值计算",
      "targetField": "attributes.charismaModifier",
      "formula": "Math.floor((charisma - 10) / 2)",
      "triggers": ["charisma"],
      "description": "计算魅力调整值"
    },
    {
      "id": "hitPoints_calculation",
      "name": "生命值计算",
      "targetField": "attributes.hitPoints",
      "formula": "(8 + constitutionModifier) + (level - 1) * (5 + constitutionModifier)",
      "triggers": ["level", "constitutionModifier"],
      "description": "计算生命值（假设d8生命骰）"
    },
    {
      "id": "baseAttackBonus_calculation",
      "name": "基础攻击加值计算",
      "targetField": "attributes.baseAttackBonus",
      "formula": "Math.floor(level * 3 / 4)",
      "triggers": ["level"],
      "description": "计算基础攻击加值（3/4 BAB职业）"
    },
    {
      "id": "armorClass_calculation",
      "name": "护甲等级计算",
      "targetField": "attributes.armorClass",
      "formula": "10 + dexterityModifier",
      "triggers": ["dexterityModifier"],
      "description": "计算护甲等级"
    },
    {
      "id": "fortitudeSave_calculation",
      "name": "强韧豁免计算",
      "targetField": "attributes.fortitudeSave",
      "formula": "Math.floor(level / 2) + constitutionModifier",
      "triggers": ["level", "constitutionModifier"],
      "description": "计算强韧豁免"
    },
    {
      "id": "reflexSave_calculation",
      "name": "反射豁免计算",
      "targetField": "attributes.reflexSave",
      "formula": "Math.floor(level / 3) + dexterityModifier",
      "triggers": ["level", "dexterityModifier"],
      "description": "计算反射豁免"
    },
    {
      "id": "willSave_calculation",
      "name": "意志豁免计算",
      "targetField": "attributes.willSave",
      "formula": "Math.floor(level / 2) + wisdomModifier",
      "triggers": ["level", "wisdomModifier"],
      "description": "计算意志豁免"
    },
    {
      "id": "initiative_calculation",
      "name": "先攻计算",
      "targetField": "initiative",
      "formula": "dexterityModifier",
      "triggers": ["dexterityModifier"],
      "description": "计算先攻值"
    },
    {
      "id": "touchAC_calculation",
      "name": "接触AC计算",
      "targetField": "touchAC",
      "formula": "10 + dexterityModifier",
